<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>Assets\DS3PortingTool-logo.ico</ApplicationIcon>
        <Authors>GompDS</Authors>
        <Version>1.3.4</Version>
        <PackageProjectUrl>https://github.com/GompDS/DS3PortingTool</PackageProjectUrl>
        <LangVersion>12</LangVersion>
        <TargetFramework>net9.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
      <Reference Include="SoulsAssetPipeline">
        <HintPath>Lib\SoulsAssetPipeline.dll</HintPath>
      </Reference>
      <Reference Include="SoulsFormats">
        <HintPath>Lib\SoulsFormats.dll</HintPath>
      </Reference>
      <Reference Include="SoulsGameSpecs">
        <HintPath>..\SoulsGameSpecs.dll</HintPath>
      </Reference>
    </ItemGroup>
    
    <ItemGroup>
        <CopyHavokDowngrade Include="HavokDowngrade\**\**\*" />
    </ItemGroup>
    
    <ItemGroup>
      <None Remove="Res\**" />
      <AdditionalFiles Include="Res\**">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </AdditionalFiles>
      <None Remove="texconv.exe" />
      <AdditionalFiles Include="texconv.exe">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </AdditionalFiles>
      <None Remove="ValidGameSpecs.json" />
      <AdditionalFiles Include="ValidGameSpecs.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </AdditionalFiles>
      <None Remove="Converter\**" />
      <None Remove="Util\**" />
      <None Remove="havok\**" />
      <AdditionalFiles Include="havok\**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </AdditionalFiles>
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\FLVERMaterialHelper\FLVERMaterialHelper\FLVERMaterialHelper.csproj" />
      <ProjectReference Include="..\SoulsFormatsNEXT\SoulsFormats\SoulsFormats.csproj" />
    </ItemGroup>
    
    <ItemGroup>
      <Folder Include="Res\MATBIN\" />
    </ItemGroup>
    
    <ItemGroup>
      <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.8.0" />
      <PackageReference Include="Magick.NET.Core" Version="14.8.0" />
    </ItemGroup>
    
    <ItemGroup>
      <Compile Remove="Converter\**" />
      <Compile Remove="Util\**" />
      <Compile Remove="XmlData.cs" />
    </ItemGroup>
    
    <ItemGroup>
      <EmbeddedResource Remove="Converter\**" />
      <EmbeddedResource Remove="Util\**" />
    </ItemGroup>
</Project>
