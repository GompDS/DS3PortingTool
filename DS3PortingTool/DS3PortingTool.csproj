<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>Assets\DS3PortingTool-logo.ico</ApplicationIcon>
        <Authors>GompDS</Authors>
        <Version>1.3.5</Version>
        <PackageProjectUrl>https://github.com/GompDS/DS3PortingTool</PackageProjectUrl>
        <LangVersion>12</LangVersion>
        <TargetFramework>net9.0</TargetFramework>
    </PropertyGroup>
    
    <ItemGroup>
      <None Remove="Res\**" />
      <AdditionalFiles Include="Res\**">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </AdditionalFiles>
      <None Remove="ValidGameSpecs.json" />
      <AdditionalFiles Include="ValidGameSpecs.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </AdditionalFiles>
      <None Remove="Converter\**" />
      <None Remove="Util\**" />
      <None Remove="havok\**" />
      <AdditionalFiles Include="havok\**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </AdditionalFiles>
      <None Remove="HavokDowngrade\despacito.exe" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\..\SoulsGameSpecs\SoulsGameSpecs\SoulsGameSpecs.csproj" />
      <ProjectReference Include="..\SoulsFormatsNEXT\SoulsFormats\SoulsFormats.csproj" />
    </ItemGroup>
    
    <ItemGroup>
      <Compile Remove="Converter\**" />
      <Compile Remove="Util\**" />
      <Compile Remove="XmlData.cs" />
    </ItemGroup>
    
    <ItemGroup>
      <EmbeddedResource Remove="Converter\**" />
      <EmbeddedResource Remove="Util\**" />
    </ItemGroup>
</Project>
